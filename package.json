    },
    {
      "displayName": "Playtest Feedback Game Context",
      "description": "Shows how to attach game-specific state (player position, checkpoint, inventory...) to every playtest feedback report.",
      "path": "Samples~/PlaytestFeedbackGameContext"
    }
